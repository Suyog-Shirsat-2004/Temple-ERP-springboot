# Temple ERP - Example environment variables
# Copy values into your Render service Environment settings (or local environment).
# Never commit real secrets.

# Server / runtime
PORT=5000

# MongoDB Atlas (required for Render deployment)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/temple_erp?retryWrites=true&w=majority&appName=TempleERP
MONGO_URI=

# Security
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MS=2592000000

# Admin bootstrap (change in production)
APP_ADMIN_USERNAME=Admin123
APP_ADMIN_EMAIL=templeerp2027@gmail.com
APP_ADMIN_PASSWORD=change-me

# File uploads (Render disk mount path recommended for persistence)
UPLOAD_DIR=/var/data/uploads

# Email (Gmail SMTP) - optional but recommended for pass/receipt/order notifications
APP_MAIL_ENABLED=true
APP_MAIL_FROM=your-email@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Optional logging/error behavior
THYMELEAF_CACHE=true
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_EXCEPTION=false
SERVER_ERROR_INCLUDE_STACKTRACE=never
FORWARD_HEADERS_STRATEGY=framework
